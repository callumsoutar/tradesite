# Public site URL used for canonical links and emails.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase. Use the publishable key in the browser. The secret key stays on the server.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Older projects can set this instead of the publishable key.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SECRET_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# Only this Auth user can open /admin. Create the user in Supabase and turn off public sign-ups.
ADMIN_EMAIL=

# Resend. RESEND_FROM_EMAIL must be a verified sender, for example "TradeSite <hello@yourdomain.co.nz>".
RESEND_API_KEY=
RESEND_FROM_EMAIL=
ENQUIRY_NOTIFICATION_EMAIL=

# Optional analytics. Leave blank until the domain is live.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
